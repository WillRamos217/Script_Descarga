# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN (.env.example)
# Copia este archivo como .env y coloca tus datos reales
# ==============================================================================

# 1. CREDENCIALES Y CARPETA DE APPIAN
APPIAN_USERNAME=tu_usuario@dominio.com
APPIAN_PASSWORD=tu_contraseña_aqui
APPIAN_FOLDER_URL=link de la carpeta

# 2. CARPETA LOCAL DE DESCARGA Y OPCIONES DE ELIMINACIÓN
# Por defecto: ./descargas
DOWNLOAD_DIR=./descargas

# ¿Eliminar de Appian los archivos de cada página después de descargarlos y comprobarlos?
# Opciones: true | false (por defecto false para no borrar nada a menos que se active)
DELETE_AFTER_DOWNLOAD=false

# 3. FILTROS DE BÚSQUEDA EN APPIAN DESIGNER (deja vacío lo que no uses)
# Buscar por "Nombre o descripción"
FILTER_SEARCH_TEXT=

# Filtrar por "TIPO DE OBJETO" (Documento, Carpeta de Documentos, Informe de Proceso)
FILTER_OBJECT_TYPES=

# Filtrar por "ÚLTIMA MODIFICACIÓN POR" (usuario o usuarios separados por coma)
FILTER_MODIFIED_BY=

# Filtrar por "ÚLTIMA MODIFICACIÓN" (Formato DD/MM/YYYY)
FILTER_DATE_FROM=25/01/2026
FILTER_DATE_TO=05/06/2026
